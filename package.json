{
  "name": "lummoo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lummoo/contracts build && pnpm --parallel --filter @lummoo/frontend --filter @lummoo/api dev",
    "build": "pnpm --filter @lummoo/contracts build && pnpm --filter @lummoo/api build && pnpm --filter @lummoo/frontend build",
    "typecheck": "pnpm --filter @lummoo/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @lummoo/contracts build && pnpm --filter @lummoo/api test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:vercel": "pnpm build && node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "prettier": "^3.6.2",
    "esbuild": "0.28.0"
  }
}
